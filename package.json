{
  "name": "vue-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "concurrently -c \"auto\" \"npm:lint:js\" \"npm:lint:css\"",
    "lint:js": "biome check src",
    "lint:css": "stylelint src/**/*.{css,scss}",
    "fix": "concurrently -c \"auto\" \"npm:fix:js\" \"npm:fix:css\"",
    "fix:js": "biome check --write --unsafe src",
    "fix:css": "stylelint --fix \"strict\" src/**/*.{css,scss,vue}"
  },
  "dependencies": {
    "@nanostores/i18n": "^0.12.2",
    "@nanostores/logger": "^0.4.0",
    "@nanostores/persistent": "^0.10.2",
    "@nanostores/vue": "^0.11.0",
    "axios": "^1.7.9",
    "bulma": "^1.0.3",
    "nanostores": "^0.11.3",
    "rxjs": "^7.8.1",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "lefthook": "^1.10.10",
    "sass": "^1.85.0",
    "stylelint": "^16.14.1",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
