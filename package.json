  "devDependencies": {
    "@biomejs/biome": "1.8.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.0",
    "lefthook": "^1.6.15",
    "postcss": "^8.4.38",
